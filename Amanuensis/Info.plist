<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- standard keys -->
  <key>CFBundleExecutable</key>           <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>           <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key>                 <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>          <string>APPL</string>
  <key>CFBundleShortVersionString</key>   <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>              <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSUIElement</key>                  <true/>          <!-- menu-bar-only app -->
  <key>NSPrincipalClass</key>             <string>NSApplication</string>

  <!-- privacy -->
  <key>NSScreenCaptureUsageDescription</key>
  <string>ScreenScribe needs screen-recording permission to capture screenshots for content extraction.</string>

  <!-- allow http endpoints on the local machine (Ollama, LM Studio, …) -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
    <!-- local-networking skips dotted names like llm.localhost, so allow *.localhost explicitly -->
    <key>NSExceptionDomains</key>
    <dict>
      <key>localhost</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
